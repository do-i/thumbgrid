            "LMB_Drag"
        ],
        "dragZoom": [
            "RMB_Drag"
        ],
        "fitNormal": [
            "3"
        ],
        "fitWidth": [
            "2"
        ],
        "fitWindow": [
            "1"
        ],
        "fitWindowStretch": [
            "4"
        ],
        "flipH": [
            "H"
        ],
        "flipV": [
            "V"
        ],
        "folderView": [
            "Backspace",
            "Enter",
            "U"
        ],
        "frameStep": [
            "."
