{
    "_meta": {
        "id": "qimgv",
        "name": "qimgv",
        "description": "thumbgrid's ancestor scheme; default and first-run seed",
        "os": [
            "linux",
            "windows",
            "macos"
        ],
        "order": 0,
        "source": "thumbgrid/qimgv default shortcuts",
        "notice": "Default scheme inherited from qimgv (thumbgrid is a qimgv fork)."
    },
    "global": {
        "closeFullScreenOrExit": [
            "Esc"
        ],
        "contextMenu": [
            "Menu",
            "RMB"
        ],
        "copyFile": [
            "C"
        ],
        "copyFileClipboard": [
            "$Ctrl+C"
        ],
        "copyPathClipboard": [
            "$Ctrl+$Shift+C"
        ],
        "cutFile": [
            "$Ctrl+X"
        ],
        "exit": [
            "$Alt+X",
            "$Ctrl+Q"
        ],
        "moveFile": [
            "M"
        ],
        "moveToTrash": [
            "Del"
        ],
        "open": [
            "$Ctrl+O"
        ],
        "openSettings": [
            "F12"
        ],
        "pasteFile": [
            "$Ctrl+V"
        ],
        "removeFile": [
            "$Shift+Del"
        ],
        "renameFile": [
            "F2"
