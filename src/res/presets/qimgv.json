        ],
        "selectPrevious": [
            "Left"
        ],
        "selectNext": [
            "Right"
        ],
        "selectAbove": [
            "Up"
        ],
        "selectBelow": [
            "Down"
        ],
        "selectPageUp": [
            "PgUp"
        ],
        "selectPageDown": [
            "PgDown"
        ],
        "selectFirst": [
            "Home"
        ],
        "selectLast": [
            "End"
        ],
        "startSearch": [
            "/"
        ],
        "toggleFolderViewTopBar": [
            "$Ctrl+T"
        ],
        "toggleImageInfo": [
            "I"
        ],
        "zoomIn": [
            "$Ctrl+WheelUp"
        ],
        "zoomOut": [
            "$Ctrl+WheelDown"
        ],
