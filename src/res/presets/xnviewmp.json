{
    "_meta": {
        "id": "xnviewmp",
        "name": "XnView MP-style",
        "description": "Shortcuts modeled on XnView MP conventions",
        "os": ["linux", "windows", "macos"],
        "order": 20,
        "source": "Illustrative partial reconstruction of XnView MP documented defaults",
        "notice": "Independent reconstruction; 'XnView MP' is a trademark of its owner; not affiliated or endorsed."
    },
    "global": {
        "closeFullScreenOrExit": ["Esc"],
        "contextMenu": ["Menu", "RMB"],
        "toggleFullscreen": ["F11"],
        "moveToTrash": ["Del"],
        "removeFile": ["$Shift+Del"],
        "renameFile": ["F2"],
        "open": ["$Ctrl+O"],
        "exit": ["$Ctrl+Q"],
        "copyFileClipboard": ["$Ctrl+C"],
        "cutFile": ["$Ctrl+X"],
        "pasteFile": ["$Ctrl+V"]
    },
    "document": {
        "clearClip": ["|"],
        "setClipEnd": ["]"],
        "setClipStart": ["["],
        "toggleVideoLoop": ["\\"],
        "dragPan": ["LMB_Drag"],
        "dragZoom": ["RMB_Drag"],
        "nextImage": ["PgDown", "Right", "LMB_RightEdge"],
        "pauseVideo": ["Space"],
        "prevImage": ["PgUp", "Left", "LMB_LeftEdge"],
        "folderView": ["Backspace", "Enter"],
        "zoomIn": ["+", "="],
        "zoomOut": ["-"],
        "zoomInCursor": ["RMB+WheelUp"],
        "zoomOutCursor": ["RMB+WheelDown"],
        "rotateLeft": ["L"],
        "rotateRight": ["R"],
        "flipH": ["H"],
        "flipV": ["V"],
        "toggleImageInfo": ["I"],
        "jumpToFirst": ["Home"],
        "jumpToLast": ["End"],
        "print": ["$Ctrl+P"],
        "save": ["$Ctrl+S"],
        "saveAs": ["$Ctrl+$Shift+S"],
        "discardEdits": ["$Ctrl+Z"]
    },
    "grid": {
        "createDirectory": ["F7"],
        "goUp": ["Backspace"],
        "moveFile": ["M"],
        "toggleImageInfo": ["I"],
        "openSelected": ["Enter", "LMB_TileDoubleClick"],
        "selectAll": ["$Ctrl+A"],
        "startSearch": ["/"],
        "selectPrevious": ["Left"],
        "selectNext": ["Right"],
        "selectAbove": ["Up"],
        "selectBelow": ["Down"],
        "selectPageUp": ["PgUp"],
        "selectPageDown": ["PgDown"],
        "selectFirst": ["Home"],
        "selectLast": ["End"],
        "zoomIn": ["$Ctrl+WheelUp"],
        "zoomOut": ["$Ctrl+WheelDown"],
        "dragFileOut": ["LMB_Drag"]
    },
    "copyMove": {
        "sendToFolder1": ["1"],
        "sendToFolder2": ["2"],
        "sendToFolder3": ["3"],
        "sendToFolder4": ["4"],
        "sendToFolder5": ["5"],
        "sendToFolder6": ["6"],
        "sendToFolder7": ["7"],
        "sendToFolder8": ["8"],
        "sendToFolder9": ["9"]
    },
    "clipEdit": {
        "cancelClipEdit": ["Esc"],
        "commitClipEdit": ["Enter"]
    }
}
