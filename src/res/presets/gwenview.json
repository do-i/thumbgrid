{
    "_meta": {
        "id": "gwenview",
        "name": "Gwenview-style",
        "description": "Shortcuts modeled on KDE Gwenview conventions",
        "os": ["linux"],
        "order": 10,
        "source": "Illustrative partial reconstruction of Gwenview defaults",
        "notice": "Independent reconstruction; 'Gwenview' is a trademark of its owners; not affiliated or endorsed."
    },
    "global": {
        "closeFullScreenOrExit": ["Esc"],
        "contextMenu": ["Menu", "RMB"],
        "toggleFullscreen": ["F11", "LMB_DoubleClick"],
        "moveToTrash": ["Del"],
        "removeFile": ["$Shift+Del"],
        "open": ["$Ctrl+O"],
        "exit": ["$Ctrl+Q"],
        "renameFile": ["F2"],
        "copyFileClipboard": ["$Ctrl+C"],
        "cutFile": ["$Ctrl+X"],
        "pasteFile": ["$Ctrl+V"],
        "showInDirectory": ["$Ctrl+D"],
        "openSettings": ["$Ctrl+$Shift+Comma"]
    },
    "document": {
        "dragPan": ["LMB_Drag"],
        "dragZoom": ["RMB_Drag"],
        "nextImage": ["PgDown", "Right", "LMB_RightEdge"],
        "pauseVideo": ["Space"],
        "prevImage": ["PgUp", "Left", "LMB_LeftEdge"],
        "goUp": ["Backspace"],
        "zoomIn": ["+", "=", "$Ctrl++"],
        "zoomOut": ["-", "$Ctrl+-"],
        "zoomInCursor": ["RMB+WheelUp"],
        "zoomOutCursor": ["RMB+WheelDown"],
        "fitWindow": ["1"],
        "fitWidth": ["2"],
        "fitNormal": ["3"],
        "rotateLeft": ["$Ctrl+L"],
        "rotateRight": ["$Ctrl+R"],
        "jumpToFirst": ["Home"],
        "jumpToLast": ["End"],
        "save": ["$Ctrl+S"],
        "saveAs": ["$Ctrl+$Shift+S"]
    },
    "grid": {
        "createDirectory": ["F10"],
        "goUp": ["Backspace"],
        "moveFile": ["M"],
        "openSelected": ["Enter"],
        "selectAll": ["$Ctrl+A"],
        "startSearch": ["/"],
        "selectPrevious": ["Left"],
        "selectNext": ["Right"],
        "selectAbove": ["Up"],
        "selectBelow": ["Down"],
        "selectPageUp": ["PgUp"],
        "selectPageDown": ["PgDown"],
        "selectFirst": ["Home"],
        "selectLast": ["End"],
        "zoomIn": ["$Ctrl+WheelUp"],
        "zoomOut": ["$Ctrl+WheelDown"]
    },
    "copyMove": {
        "sendToFolder1": ["1"],
        "sendToFolder2": ["2"],
        "sendToFolder3": ["3"],
        "sendToFolder4": ["4"],
        "sendToFolder5": ["5"],
        "sendToFolder6": ["6"],
        "sendToFolder7": ["7"],
        "sendToFolder8": ["8"],
        "sendToFolder9": ["9"]
    }
}
