{
    "_meta": {
        "id": "irfanview",
        "name": "IrfanView-style",
        "description": "Shortcuts modeled on IrfanView defaults",
        "os": ["windows"],
        "order": 40,
        "source": "Illustrative partial reconstruction of IrfanView defaults",
        "notice": "Independent reconstruction; 'IrfanView' is a trademark of its owner; not affiliated."
    },
    "global": {
        "toggleFullscreen": ["Enter"],
        "openSettings": ["P"],
        "moveToTrash": ["Del"]
    },
    "document": {
        "clearClip": ["|"],
        "setClipEnd": ["]"],
        "setClipStart": ["["],
        "toggleVideoLoop": ["\\"],
        "dragPan": ["LMB_Drag"],
        "dragZoom": ["RMB_Drag"],
        "nextImage": ["Right", "LMB_RightEdge"],
        "pauseVideo": ["Space"],
        "prevImage": ["Backspace", "Left", "LMB_LeftEdge"],
        "zoomInCursor": ["RMB+WheelUp"],
        "zoomOutCursor": ["RMB+WheelDown"]
    },
    "grid": {
        "moveFile": ["M"],
        "removeFile": ["$Shift+Del"],
        "renameFile": ["F2"],
        "goUp": ["Backspace"],
        "openSelected": ["Enter", "LMB_TileDoubleClick"],
        "selectAll": ["$Ctrl+A"],
        "startSearch": ["/"],
        "selectPrevious": ["Left"],
        "selectNext": ["Right"],
        "selectAbove": ["Up"],
        "selectBelow": ["Down"],
        "selectPageUp": ["PgUp"],
        "selectPageDown": ["PgDown"],
        "selectFirst": ["Home"],
        "selectLast": ["End"],
        "zoomIn": ["$Ctrl+WheelUp"],
        "zoomOut": ["$Ctrl+WheelDown"],
        "dragFileOut": ["LMB_Drag"]
    },
    "copyMove": {
        "sendToFolder1": ["1"],
        "sendToFolder2": ["2"],
        "sendToFolder3": ["3"],
        "sendToFolder4": ["4"],
        "sendToFolder5": ["5"],
        "sendToFolder6": ["6"],
        "sendToFolder7": ["7"],
        "sendToFolder8": ["8"],
        "sendToFolder9": ["9"]
    }
}
